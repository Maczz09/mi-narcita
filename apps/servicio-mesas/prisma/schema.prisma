generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MesaEstado {
  LIBRE
  OCUPADA
  RESERVADA
}

model Mesa {
  id             String     @id @default(uuid())
  // T-23 (multi-sede): el número de mesa es único DENTRO de su sede, no
  // globalmente — dos locales pueden tener cada uno su "Mesa 01".
  numero         Int
  sedeId         String
  capacidad      Int
  ubicacionId    String
  ubicacion      Ubicacion  @relation(fields: [ubicacionId], references: [id])
  estado         MesaEstado @default(LIBRE)
  cuentaAsociada String?
  // Unir mesas: todas las mesas de un mismo grupo (incluida la anfitriona)
  // comparten el mismo grupoId = id de la mesa anfitriona. null = no unida.
  grupoId        String?
  grupo          Mesa?      @relation("GrupoMesas", fields: [grupoId], references: [id])
  mesasDelGrupo  Mesa[]     @relation("GrupoMesas")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([sedeId, numero])
  @@index([estado])
  @@index([ubicacionId])
  @@index([grupoId])
  @@index([sedeId])
  @@map("mesas")
}

model Ubicacion {
  id        String   @id @default(uuid())
  // T-23: el nombre de la zona es único DENTRO de su sede (dos locales
  // pueden tener cada uno su "Salón Principal").
  nombre    String
  sedeId    String
  mesas     Mesa[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sedeId, nombre])
  @@index([sedeId])
  @@map("ubicaciones")
}

model OutboxEvent {
  id         String   @id @default(uuid())
  routingKey String
  payload    String
  status     String   @default("PENDING")
  attempts   Int      @default(0)
  claimedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@map("outbox_events")
}

model IdempotencyKey {
  key       String   @id
  createdAt DateTime @default(now())

  @@map("idempotency_keys")
}
