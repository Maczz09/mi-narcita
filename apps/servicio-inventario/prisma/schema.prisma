generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Categoria {
  id             String      @id @default(uuid())
  nombre         String      @unique
  descripcion    String?
  parentId       String?
  // Un solo nivel de subcategorías a propósito (parent no puede tener su
  // propio parent) — se valida en el servicio, no en el schema.
  parent         Categoria?  @relation("Subcategorias", fields: [parentId], references: [id])
  subcategorias  Categoria[] @relation("Subcategorias")
  productos      Producto[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([parentId])
  @@map("categorias")
}

model Producto {
  id          String       @id @default(uuid())
  categoriaId String
  categoria   Categoria    @relation(fields: [categoriaId], references: [id])
  nombre      String
  descripcion String?
  precio      Decimal      @db.Decimal(10, 2)
  disponible  Boolean      @default(true)
  stockActual Int?
  menuDiario  MenuDiario[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoriaId])
  @@map("productos")
}

// T-20: menú del día — selección de productos ofrecidos en una fecha
// concreta, independiente de la carta fija. Un mismo Producto puede estar en
// la carta y/o en el menú de hoy, cada uno con su propia disponibilidad
// (@@unique evita duplicar el mismo producto el mismo día; reactivar =
// upsert sobre esa clave en vez de crear una fila nueva).
model MenuDiario {
  id          String   @id @default(uuid())
  fecha       DateTime @db.Date
  productoId  String
  producto    Producto @relation(fields: [productoId], references: [id])
  disponible  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([fecha, productoId])
  @@index([fecha])
  @@map("menu_diario")
}

model OutboxEvent {
  id         String   @id @default(uuid())
  routingKey String
  payload    String
  status     String   @default("PENDING")
  attempts   Int      @default(0)
  claimedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@map("outbox_events")
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("idempotency_keys")
}
