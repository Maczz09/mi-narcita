generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Categoria {
  id             String      @id @default(uuid())
  nombre         String      @unique
  descripcion    String?
  parentId       String?
  // Un solo nivel de subcategorías a propósito (parent no puede tener su
  // propio parent) — se valida en el servicio, no en el schema.
  parent         Categoria?  @relation("Subcategorias", fields: [parentId], references: [id])
  subcategorias  Categoria[] @relation("Subcategorias")
  productos      Producto[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([parentId])
  @@map("categorias")
}

model Producto {
  id          String    @id @default(uuid())
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  nombre      String
  descripcion String?
  precio      Decimal   @db.Decimal(10, 2)
  disponible  Boolean   @default(true)
  stockActual Int?      
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoriaId])
  @@map("productos")
}

model OutboxEvent {
  id         String   @id @default(uuid())
  routingKey String
  payload    String
  status     String   @default("PENDING")
  attempts   Int      @default(0)
  claimedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@map("outbox_events")
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("idempotency_keys")
}
