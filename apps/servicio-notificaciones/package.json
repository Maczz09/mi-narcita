{
    "name":  "@org/servicio-notificaciones",
    "version":  "0.0.1",
    "private":  true,
    "nx":  {
               "name":  "servicio-notificaciones",
               "targets":  {
                               "build":  {
                                             "executor":  "nx:run-commands",
                                             "outputs":  [
                                                             "{workspaceRoot}/dist/apps/servicio-notificaciones"
                                                         ],
                                             "options":  {
                                                             "command":  "tsc -p apps/servicio-notificaciones/tsconfig.app.json \u0026\u0026 npx tsc-alias -p apps/servicio-notificaciones/tsconfig.app.json \u0026\u0026 node -e \"const fs=require(\u0027fs\u0027); if(fs.existsSync(\u0027apps/servicio-notificaciones/src/generated\u0027)) fs.cpSync(\u0027apps/servicio-notificaciones/src/generated\u0027, \u0027dist/apps/servicio-notificaciones/apps/servicio-notificaciones/src/generated\u0027, {recursive: true})\""
                                                         },
                                             "configurations":  {
                                                                    "production":  {

                                                                                   },
                                                                    "development":  {

                                                                                    }
                                                                }
                                         },
                               "serve":  {
                                             "executor":  "nx:run-commands",
                                             "dependsOn":  [
                                                               "build"
                                                           ],
                                             "options":  {
                                                             "command":  "node dist/apps/servicio-notificaciones/apps/servicio-notificaciones/src/main.js"
                                                         },
                                             "continuous":  true
                                         }
                           },
               "tags":  [
                            "backend",
                            "service",
                            "notificaciones"
                        ]
           },
    "dependencies":  {
                         "@nestjs/common":  "^11.0.0",
                         "@nestjs/core":  "^11.0.0",
                         "@nestjs/platform-express":  "^11.0.0",
                         "reflect-metadata":  "^0.1.13",
                         "rxjs":  "^7.8.0",
                         "tslib":  "^2.3.0",
                         "@nestjs/jwt":  "^11.0.0",
                         "@org/resiliencia":  "*",
                         "@org/contracts":  "*",
                         "@org/shared-prisma":  "*",
                         "@org/shared-rabbitmq":  "*",
                         "@org/observabilidad":  "*",
                         "@org/shared-auth":  "*"
                     },
    "devDependencies":  {
                            "@nestjs/testing":  "^11.0.0"
                        }
}
