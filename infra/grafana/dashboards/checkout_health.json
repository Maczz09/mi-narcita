{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Checkout Health",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "title": "ERP (Inventario) p95 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{instance=\"servicio-inventario:3000\"}[5m])) by (le))",
          "refId": "A",
          "exemplar": true
        }
      ]
    },
    {
      "title": "ERP (Inventario) Timeout Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(dependency_timeout_total{dependency=\"inventario\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Circuit Breaker State (Inventario)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "max by (dependency) (circuit_breaker_state{dependency=\"inventario\"})",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Outbox Pending Events (todos los servicios)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 9 },
      "targets": [
        {
          "expr": "sum(outbox_pending_total)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Outbox Publish Lag p95 (s)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(outbox_publish_lag_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Pagos & Broker",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }
    },
    {
      "title": "Pagos con cierre de cuenta pendiente (análogo PAYMENT_UNKNOWN)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(pagos_cierre_remoto_pendiente_total[10m]))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Broker Consumer Lag p95 (s)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(broker_consumer_lag_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "DLQ Messages (rate/min)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(dlq_messages_total[5m])) * 60",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": [],
  "templating": { "list": [] },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
