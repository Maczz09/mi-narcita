              "mode": "raw",
              "raw": "{\n  \"mesaId\": \"{{mesa_id}}\",\n  \"items\": [\n    {\n      \"productoId\": \"{{producto_id}}\",\n      \"cantidad\": 2,\n      \"area\": \"COCINA\",\n      \"notas\": \"Sin picante\"\n    }\n  ],\n  \"cliente\": \"Cliente Mostrador\"\n}",
