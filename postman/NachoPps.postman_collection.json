    {
      "name": "Identidad (Auth y Usuarios)",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{identidad_url}}", "host": ["{{identidad_url}}"], "path": [] },
            "description": "Público. Responde `{ status: 'OK', service: 'Identidad' }`."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.access_token) {",
                  "        pm.collectionVariables.set('access_token', body.access_token);",
                  "        pm.environment.set('access_token', body.access_token);",
                  "    }",
                  "    if (body.usuario && body.usuario.id) {",
                  "        pm.collectionVariables.set('usuario_id', body.usuario.id);",
                  "        pm.environment.set('usuario_id', body.usuario.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{identidad_url}}/auth/login", "host": ["{{identidad_url}}"], "path": ["auth", "login"] },
            "description": "Público. Guarda `access_token` y `usuario_id` en variables de colección automáticamente."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.access_token) {",
                  "        pm.collectionVariables.set('access_token', body.access_token);",
                  "        pm.environment.set('access_token', body.access_token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{identidad_url}}/auth/refresh", "host": ["{{identidad_url}}"], "path": ["auth", "refresh"] },
            "description": "Público. El flujo normal usa la cookie httpOnly `refresh_token` (Postman la reenvía sola si Login se ejecutó antes en la misma sesión); el body es un fallback opcional."
          },
          "response": []
